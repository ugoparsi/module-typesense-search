<config>
    <modules>
        <Community_TypesenseSearch>
            <version>1.0.0</version>
        </Community_TypesenseSearch>
    </modules>
    <global>
        <helpers>
            <typesensesearch>
                <class>Community_TypesenseSearch_Helper</class>
            </typesensesearch>
            <catalogsearch>
                <rewrite>
                    <data>Community_TypesenseSearch_Helper_CatalogSearch</data>
                </rewrite>
            </catalogsearch>
        </helpers>
        <models>
            <typesensesearch>
                <class>Community_TypesenseSearch_Model</class>
                <resourceModel>typesensesearch_resource</resourceModel>
            </typesensesearch>
            <typesensesearch_resource>
                <class>Community_TypesenseSearch_Model_Resource</class>
            </typesensesearch_resource>
        </models>
        <services>
            <typesensesearch>
                <class>Community_TypesenseSearch_Service</class>
            </typesensesearch>
        </services>
        <blocks>
            <typesensesearch>
                <class>Community_TypesenseSearch_Block</class>
            </typesensesearch>
        </blocks>
        <index>
            <indexer>
                <typesensesearch>
                    <model>typesensesearch/indexer</model>
                </typesensesearch>
            </indexer>
        </index>
        <queue>
            <routing>
                <typesensesearch>slow</typesensesearch>
            </routing>
        </queue>
    </global>
    <frontend>
        <translate>
            <modules>
                <typesensesearch>
                    <files>
                        <default>Community_TypesenseSearch.csv</default>
                    </files>
                </typesensesearch>
            </modules>
        </translate>
        <layout>
            <updates>
                <typesensesearch>
                    <file>typesensesearch.xml</file>
                </typesensesearch>
            </updates>
        </layout>
    </frontend>
    <adminhtml>
        <translate>
            <modules>
                <typesensesearch>
                    <files>
                        <default>Community_TypesenseSearch.csv</default>
                    </files>
                </typesensesearch>
            </modules>
        </translate>
    </adminhtml>
    <default>
        <typesensesearch>
            <general>
                <enabled>0</enabled>
            </general>
        </typesensesearch>
    </default>
</config>
